{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:govcheck:schema:assurance-evaluation:v1",
  "title": "GovCheck Assurance Evaluation Predicate v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "evaluation",
    "repository",
    "candidate",
    "base",
    "governance",
    "verifier",
    "methods",
    "independentReview"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "evaluation": {
      "type": "object",
      "required": [
        "id",
        "evaluatedOn",
        "result",
        "rules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evaluatedOn": {
          "type": "string",
          "format": "date-time"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "conflict"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "class",
              "result",
              "applies",
              "reasons"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "unknown",
                  "conflict"
                ]
              },
              "applies": {
                "type": "boolean"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "repository": {
      "type": "object",
      "required": [
        "uri",
        "vcsKind"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "vcsKind": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "required": [
        "revision",
        "contentDigest"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "tree": {
          "type": "string"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": true
    },
    "base": {
      "type": "object",
      "required": [
        "revision",
        "reference"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "tree": {
          "type": "string"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "governance": {
      "type": "object",
      "required": [
        "scopeId",
        "revision",
        "digest"
      ],
      "properties": {
        "scopeId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "profile": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "verifier": {
      "type": "object",
      "required": [
        "id",
        "version",
        "digest",
        "configDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "configDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": true
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "result",
          "scope",
          "assumptions",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "test",
              "model_check",
              "proof_check",
              "inspection",
              "analysis",
              "other"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "conflict"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/resource"
            }
          },
          "tool": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "independentReview": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "unavailable",
            "not_performed",
            "attested",
            "unknown"
          ]
        },
        "reference": {
          "$ref": "#/$defs/resource"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]+$"
      }
    },
    "resource": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "mediaType": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "independentReview": {
            "properties": {
              "status": {
                "const": "attested"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "independentReview"
        ]
      },
      "then": {
        "properties": {
          "independentReview": {
            "required": [
              "reference"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "independentReview": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "reviewer"
                ]
              },
              {
                "required": [
                  "reviewerName"
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
