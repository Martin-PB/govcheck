{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Martin-PB/govcheck/blob/main/formal/schemas/evidence-record.schema.json",
  "title": "GovCheck assurance evidence record",
  "description": "A provenance-bound record of an observation, execution or derivation relevant to one or more claims. Structural validity does not establish truth, authorization, reproducibility or current freshness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "claimIds",
    "subject",
    "governance",
    "method",
    "result",
    "provenance",
    "limitations",
    "invalidationDependencies"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "claimIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "packageRevision",
        "semanticsVersion"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "packageRevision": {
          "$ref": "#/$defs/revision"
        },
        "semanticsVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "specification": {
      "$ref": "#/$defs/artifactRevision"
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodClass",
        "scope"
      ],
      "properties": {
        "methodClass": {
          "enum": [
            "empirical-execution",
            "model-checking",
            "program-verification",
            "theorem-proving",
            "implementation-conformance",
            "normative-fidelity",
            "acceptance"
          ]
        },
        "empiricalSublevel": {
          "enum": [
            "unit",
            "integration",
            "property",
            "static-analysis"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bounds": {
          "type": "object",
          "additionalProperties": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "methodClass": {
                "const": "empirical-execution"
              }
            },
            "required": [
              "methodClass"
            ]
          },
          "then": {
            "required": [
              "empiricalSublevel"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "methodClass": {
                "not": {
                  "const": "empirical-execution"
                }
              }
            },
            "required": [
              "methodClass"
            ]
          },
          "then": {
            "not": {
              "required": [
                "empiricalSublevel"
              ]
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "invocation",
        "environment",
        "externalInputs"
      ],
      "properties": {
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "configurationDigest": {
          "$ref": "#/$defs/digest"
        },
        "invocation": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "object",
          "additionalProperties": true
        },
        "externalInputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "retrievedAt"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "format": "uri-reference"
              },
              "retrievedAt": {
                "type": "string",
                "format": "date-time"
              },
              "digest": {
                "$ref": "#/$defs/digest"
              },
              "validUntil": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-run",
            "not-applicable",
            "unsupported",
            "incomplete",
            "failed",
            "passed",
            "inconclusive",
            "unknown"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string"
        },
        "rawResult": {
          "type": "object",
          "additionalProperties": true
        },
        "rawResultReference": {
          "type": "string",
          "format": "uri-reference"
        },
        "rawResultDigest": {
          "$ref": "#/$defs/digest"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "integer",
              "string",
              "boolean"
            ]
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "rawResult"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "rawResultReference"
                ]
              },
              {
                "required": [
                  "rawResultDigest"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "rawResultReference",
            "rawResultDigest"
          ],
          "not": {
            "required": [
              "rawResult"
            ]
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "rawResult"
                ]
              },
              {
                "required": [
                  "rawResultReference"
                ]
              },
              {
                "required": [
                  "rawResultDigest"
                ]
              }
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not-run",
                  "not-applicable",
                  "unsupported"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "rawResult"
                  ]
                },
                {
                  "required": [
                    "rawResultReference"
                  ]
                },
                {
                  "required": [
                    "rawResultDigest"
                  ]
                }
              ]
            }
          },
          "else": {
            "anyOf": [
              {
                "required": [
                  "rawResult"
                ]
              },
              {
                "required": [
                  "rawResultReference",
                  "rawResultDigest"
                ]
              }
            ]
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "recordedAt"
      ],
      "properties": {
        "producer": {
          "$ref": "#/$defs/actor"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceReferences": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri-reference"
          }
        },
        "integrity": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalidationDependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vcs",
        "nativeId"
      ],
      "properties": {
        "vcs": {
          "enum": [
            "git",
            "pijul",
            "other"
          ]
        },
        "nativeId": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "format": "uri-reference"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifactId",
        "revision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source",
            "binary",
            "configuration",
            "formal-model",
            "specification",
            "dataset",
            "deployment",
            "other"
          ]
        },
        "artifactId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "repository": {
          "type": "string",
          "format": "uri-reference"
        },
        "baseRevision": {
          "$ref": "#/$defs/revision"
        },
        "candidateRevision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "artifactRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "revision"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actorId",
        "actorType"
      ],
      "properties": {
        "actorId": {
          "type": "string",
          "minLength": 1
        },
        "actorType": {
          "enum": [
            "person",
            "organization",
            "service",
            "agent"
          ]
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifactId",
        "revision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "subject",
            "base",
            "candidate",
            "governance",
            "specification",
            "tool",
            "configuration",
            "assumption",
            "external-input",
            "other"
          ]
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "description": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "status": {
                "enum": [
                  "not-run",
                  "not-applicable",
                  "unsupported"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "not": {
          "required": [
            "execution"
          ]
        }
      },
      "else": {
        "required": [
          "execution"
        ]
      }
    }
  ]
}
