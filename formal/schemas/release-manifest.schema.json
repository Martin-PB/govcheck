{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Martin-PB/govcheck/blob/main/formal/schemas/release-manifest.schema.json",
  "title": "GovCheck release evidence manifest",
  "description": "Describes the exact source artifacts and generated evidence published for one GovCheck release. The manifest is a release asset; it is not a per-release copy of source files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit"],
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "path", "sha256", "role"],
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "enum": ["source", "configuration", "documentation", "report", "other"] },
          "tool": { "type": "string" },
          "toolVersion": { "type": "string" },
          "status": { "enum": ["passed", "failed", "incomplete", "not-run", "not-applicable"] },
          "configurationSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "statesGenerated": { "type": "integer", "minimum": 0 },
          "distinctStates": { "type": "integer", "minimum": 0 },
          "transitions": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
