{
  "schemaVersion": 1,
  "model": "formal/tla/GovCheckLifecycle.tla",
  "diagram": "docs/formal/lifecycle-diagram.mmd",
  "authority": "The TLA+ module is the semantic authority. This registry is explanatory traceability metadata; it does not define or override transition guards or effects.",
  "states": [
    {"id":"Proposed","label":"Proposed"},
    {"id":"Prepared","label":"Prepared"},
    {"id":"Evaluated","label":"Evaluated"},
    {"id":"Reviewable","label":"Reviewable"},
    {"id":"Accepted","label":"Accepted"},
    {"id":"Applied","label":"Applied"},
    {"id":"Stale","label":"Stale"},
    {"id":"Rejected","label":"Rejected"},
    {"id":"Withdrawn","label":"Withdrawn"},
    {"id":"Superseded","label":"Superseded"}
  ],
  "transitions": [
    {"id":"prepare","operator":"Prepare","from":["Proposed"],"to":"Prepared","label":"Prepare"},
    {"id":"publish-evidence","operator":"PublishEvidence","from":["Prepared","Evaluated","Reviewable"],"to":"Prepared","label":"Publish evidence; invalidate evaluation"},
    {"id":"evaluate","operator":"Evaluate","from":["Prepared","Evaluated","Reviewable","Stale"],"to":"Reviewable","label":"Evaluate (all evidence present)"},
    {"id":"evaluate-incomplete","operator":"Evaluate","from":["Prepared","Evaluated","Reviewable","Stale"],"to":"Evaluated","label":"Evaluate (evidence incomplete)"},
    {"id":"approve","operator":"Approve","from":["Reviewable"],"to":"Reviewable","label":"Approve (authorized actor)"},
    {"id":"accept","operator":"Accept","from":["Reviewable"],"to":"Accepted","label":"Accept (predicate satisfied)"},
    {"id":"apply","operator":"Apply","from":["Accepted"],"to":"Applied","label":"Apply exact accepted candidate"},
    {"id":"change-inputs","operator":"ChangeInputs","from":["Proposed","Prepared","Evaluated","Reviewable","Accepted","Stale"],"to":"Stale","label":"Change inputs; invalidate derived state"},
    {"id":"reject","operator":"Reject","from":["Proposed","Prepared","Evaluated","Reviewable","Accepted","Stale"],"to":"Rejected","label":"Reject"},
    {"id":"withdraw","operator":"Withdraw","from":["Proposed","Prepared","Evaluated","Reviewable","Accepted","Stale"],"to":"Withdrawn","label":"Withdraw"},
    {"id":"supersede","operator":"Supersede","from":["Proposed","Prepared","Evaluated","Reviewable","Accepted","Stale"],"to":"Superseded","label":"Supersede"}
  ]
}
