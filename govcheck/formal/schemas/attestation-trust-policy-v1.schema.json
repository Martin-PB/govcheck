{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:govcheck:schema:attestation-trust-policy:v1",
  "title": "GovCheck Detached Attestation Trust Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "revision",
    "openssl",
    "keys"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "policyId": {
      "const": "govcheck.attestation-trust-policy/v1"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "openssl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:/|[A-Za-z]:[\\\\\\\\/])"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "algorithm",
          "publicKeyPath",
          "publicKeySha256",
          "principalId",
          "roles",
          "validFrom",
          "validUntil",
          "revoked"
        ],
        "properties": {
          "keyId": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "const": "ed25519"
          },
          "publicKeyPath": {
            "type": "string",
            "minLength": 1
          },
          "publicKeySha256": {
            "$ref": "#/$defs/sha256"
          },
          "principalId": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "revoked": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
