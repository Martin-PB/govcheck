{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:govcheck:schema:independent-review:v1",
  "title": "GovCheck Detached Independent Review Predicate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "candidateRevision", "candidateContentSha256",
    "baseRevision", "governanceRevision", "scopeId", "reviewedOn",
    "outcome", "claimsReviewed", "observations", "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "candidateRevision": { "type": "string", "minLength": 1 },
    "candidateContentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "baseRevision": { "type": "string", "minLength": 1 },
    "governanceRevision": { "type": "string", "minLength": 1 },
    "scopeId": { "type": "string", "minLength": 1 },
    "reviewedOn": { "type": "string", "format": "date-time" },
    "outcome": { "enum": ["accepted", "changes_requested"] },
    "claimsReviewed": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "observations": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}